header.header
    #header.header__container.container
        .header__body
            .header__left
                a.header__logo(href="#")
                    img(src='./img/logo.png', alt='logo')

                .header__menu.menu
                    button.menu__icon.icon-menu(type="button")
                        span

                    nav.menu__body
                        ul.menu__list
                            each item in menuItems
                                li.menu__item
                                    a.menu__link(href=item.url)= item.text
            .header__right
                .header__phone-wrap
                    a.header__phone(href="#")
                        | +7 (495) 221-77-69
                    p.header__phone-label 
                        | Заказать звонок вы
                .header__actions.actions
                    each action in headerActions
                        if action.type === 'cart'
                            .actions__item.actions__item--cart
                                .actions__icon.actions__icon--cart 0
                        else
                            a(href=action.href, class=`actions__item actions__item--${action.type}`)
                                img.actions__icon(src=`./img/icons/${action.icon}`, alt=action.alt)
    .cart-modal
        .cart-modal__panel
            button.cart-modal__close(type="button")
                img(src='./img/icons/close.svg', alt='close')
            h2.cart-modal__title Корзина  
            .cart-modal__header 
                span.cart-modal__count (0 товаров)
                button.cart-modal__clear(type="button") очистить список
            .cart-modal__items
            .cart-modal__footer
                .cart-modal__total
                    div Итого
                    div.cart-modal__sum 0 ₽
                button.cart-modal__order Оформить заказ
