doctype html
html(lang="en")
    include html/head.pug
    body
        .wrapper
            include html/header.pug
            main.page
                section.page__mainscreen.mainscreen
                    .mainscreen__container.container
                        include html/breadcrumbs.pug
                        .mainscreen__title 
                            | Краски
                    .mainscreen__swiper.swiper-main.swiper
                        .swiper-wrapper
                            each slide in slides
                                .swiper-slide.swiper-main__slide.slide-main
                                    .slide-main__image
                                        img(src=slide.image, alt=slide.title)
                                    .slide-main__content
                                        h2.slide-main__title= slide.title
                                        p.slide-main__descr= slide.description
                        .swiper-main__prev.swiper-button-prev
                            img(src='./img/icons/right.svg', alt='prev')
                        .swiper-main__next.swiper-button-next
                            img(src='./img/icons/right.svg', alt='next')
                        .swiper-main__dots.swiper-pagination               

                section.page__catalog.catalog
                    .catalog__container.container
                        .catalog__body
                            .catalog__filters.filters-catalog 
                                .filters-catalog__title
                                    | Фильтры
                                .filters-catalog__items
                                    each filter, index in ['Новинки', 'Есть в наличии', 'Контрактные', 'Эксклюзивные', 'Распродажа']
                                        - const value = filter.toLowerCase()
                                        - const inputId = `filter-${index}`
                                        label.filters-catalog__item(for=inputId)
                                            input.filters-catalog__checkbox(type="checkbox", value=value, id=inputId, name="product-filter")
                                            span.filters-catalog__custom
                                            span.filters-catalog__label= filter
                            .catalog__content
                                .catalog__header.catalog-header 
                                    .catalog-header__quantity
                                    .catalog-header__filter.sort-dropdown
                                        button.sort-dropdown__button(type="button")
                                            span.sort-dropdown__label Сначала популярные
                                            img.sort-dropdown__icon(src="./img/icons/down.svg", alt="arrow")
                                        ul.sort-dropdown__list
                                            li(data-sort="expensive") Сначала дорогие
                                            li(data-sort="cheap") Сначала недорогие
                                            li(data-sort="popular" class="active") Сначала популярные
                                            li(data-sort="new") Сначала новые
                                .catalog__products.products-catalog
                                    .products-catalog__items

            include html/footer.pug
            
            .cover

        script(src="https://cdn.jsdelivr.net/npm/swiper@8.4.7/swiper-bundle.min.js")
        script(src="js/app.min.js")
        